# --- Base de datos ---
# Replica set de un solo nodo (docker-compose.yml). El parámetro replicaSet es
# obligatorio para que el driver habilite transacciones.
MONGODB_URI="mongodb://localhost:27017/silmari?replicaSet=rs0"

# --- Auth (Fase 1) ---
# Secreto para firmar los JWT de sesión (jose). Genéralo con:
#   openssl rand -base64 32
AUTH_SECRET=""

# --- App ---
NODE_ENV="development"
# URL base para enlaces absolutos (invitaciones, callbacks OAuth).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Dominio mostrado como sufijo del subdominio de workspace en el onboarding.
NEXT_PUBLIC_APP_DOMAIN="silmari.app"
# Nombre de marca en pantallas públicas.
NEXT_PUBLIC_APP_NAME="Silmari"

# --- Google OAuth (Fase 12) ---
# Crea un "OAuth client ID" de tipo Web en Google Cloud Console y registra la
# URI de redirección: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
# Sin estas variables, el botón "Continuar con Google" queda deshabilitado.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Microsoft OAuth ---
# Registra una app en Azure Portal → App registrations. Redirección (tipo Web):
# {NEXT_PUBLIC_APP_URL}/api/auth/microsoft/callback. Crea un "client secret".
# MICROSOFT_TENANT: 'common' (cuentas de trabajo y personales) por defecto, o el
# tenant id para un solo inquilino. Sin CLIENT_ID/SECRET el botón queda desactivado.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT="common"

# --- Cifrado de secretos de integraciones ---
# Clave con la que se cifran en reposo la contraseña SMTP y el token de WhatsApp.
# Se separa de AUTH_SECRET a propósito: rotar el secreto de sesión no debe dejar
# ilegibles los secretos de los workspaces. Genérala igual:
#   openssl rand -base64 32
# Si no la defines se usa AUTH_SECRET (compatibilidad). Para migrar de una a
# otra: scripts/rotate-integration-secret.mjs (ver RUNBOOK.md).
INTEGRATIONS_SECRET=""

# --- Correo transaccional del sistema (recuperar contraseña, invitaciones) ---
# Distinto del SMTP que cada workspace configura en Ajustes → Integraciones para
# escribir a SUS clientes. Este es el remitente de Silmari.
# Proveedor: "resend" o "console". Sin RESEND_API_KEY se usa "console", que no
# envía nada y escribe el correo (con el enlace) en el log: útil en desarrollo.
MAIL_PROVIDER=""
# Remitente verificado en Resend. Usa un subdominio para lo transaccional, para
# aislar la reputación de envío. Ej: "Silmari <no-reply@mail.tudominio.com>"
MAIL_FROM=""
RESEND_API_KEY=""

# --- Facturación (Stripe) ---
# Sin STRIPE_SECRET_KEY la app arranca igual: la página de Facturación muestra
# los planes pero no ofrece contratar. Los límites por plan sí se aplican siempre.
STRIPE_SECRET_KEY=""
# Secreto del endpoint de webhook (Stripe → /api/stripe/webhook). En local:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""
# Ids de precio (price_...) creados en el panel de Stripe, uno por plan de pago.
# Ojo: los de prueba y los de producción son distintos.
STRIPE_PRICE_PRO=""
STRIPE_PRICE_BUSINESS=""

# --- Storage (Fase 7) ---
# Carpeta de subidas en desarrollo (disco local). En producción se usaría S3.
STORAGE_DIR="./storage"

# --- Backups (ver RUNBOOK.md) ---
# Carpeta donde `npm run backup` deja los volcados de mongodump.
BACKUP_DIR="./backups"
# Días que se conservan los volcados en local antes de purgarse.
BACKUP_RETENTION_DAYS="30"
# Comando de subida a almacenamiento externo; se le añade la ruta del archivo.
# Sin esto el backup solo vive en el mismo servidor que la base de datos.
#   BACKUP_UPLOAD_CMD="rclone copy"
BACKUP_UPLOAD_CMD=""
